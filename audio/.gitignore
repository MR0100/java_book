# Audio is GENERATED, not committed. Reproduce it with the build script
# (see audio/README.md). Everything below is regenerable on any machine.

out/            # the generated MP3 narration tree (mirrors content/)
voices/         # downloaded Piper ONNX voice models (only for the offline engine)
samples/        # voice-comparison sample clips
manifest.json   # incremental-build cache (hash → mp3 metadata); rebuilt automatically
*.mp3           # any stray clips (e.g. ad-hoc tts output, demo.mp3)
*.log           # build logs
.DS_Store
