<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      spring-boot-starter-parent gives us:
        - a curated, conflict-free dependency BOM (we omit versions on the starters below)
        - sensible compiler/plugin defaults
        - the spring-boot-maven-plugin (repackage + `spring-boot:run`)
      3.3.x is the latest Boot 3.3 line; it requires Java 17+ and is happy on 21.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/> <!-- look the parent up from the repository, not a local dir -->
    </parent>

    <groupId>com.javamastery.examples</groupId>
    <artifactId>outbox-pattern</artifactId>
    <version>1.0.0</version>
    <name>outbox-pattern</name>
    <description>Worked system-design example: the Transactional Outbox pattern solving the
        dual-write problem (DB + broker) without distributed transactions, on H2 with no broker.</description>

    <properties>
        <!-- Targets Java 21 bytecode. Boot's compiler config turns this into a release-21 build. -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
          spring-boot-starter brings core + the @Scheduled support we use for the
          OutboxRelay poller (it is a transitive dependency of -web, listed
          explicitly here because scheduling is central to this example).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Web layer: embedded Tomcat + Spring MVC for the REST controller. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence: Spring Data JPA (Hibernate) over the Order + OutboxEvent entities. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
          H2 in-memory database, runtime scope. This is what lets the whole app
          start with ZERO external infrastructure: no Postgres/MySQL, and crucially
          NO Kafka/RabbitMQ broker. The "broker" here is a pluggable EventPublisher.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JUnit 5, AssertJ, MockMvc, Spring test slices. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Enables `mvn spring-boot:run` and builds an executable fat-jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
