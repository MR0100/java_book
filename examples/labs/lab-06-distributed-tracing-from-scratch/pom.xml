<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      TEACHING POINT: The Spring Boot parent POM.
      Inheriting from spring-boot-starter-parent gives us, for free:
        - A curated, mutually-compatible BOM (Bill of Materials) of dependency
          versions, so we almost never write <version> on Spring/Jackson deps.
        - Sensible plugin defaults (compiler, surefire, the repackage goal).
      Pin to a concrete, stable 3.3.x release for reproducible builds.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/> <!-- look the parent up from the Maven repository, not a local path -->
    </parent>

    <groupId>com.javamastery.examples</groupId>
    <artifactId>lab-06-distributed-tracing</artifactId>
    <version>1.0.0</version>
    <name>lab-06-distributed-tracing</name>
    <description>Lab: build W3C Trace Context distributed tracing from scratch (Spring Boot 3.3, Java 21)</description>

    <properties>
        <!--
          TEACHING POINT: maven.compiler.release pins the *bytecode* level to 21.
          Unlike source/target, `release` also restricts the visible JDK API to
          Java 21, so you cannot accidentally call a Java 22+ method. This lets a
          newer JDK (e.g. 22/23/24/25) compile and run the project while still
          producing genuine Java 21 class files. We set BOTH java.version (read by
          the Spring Boot parent) and maven.compiler.release for belt-and-braces.
        -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
          Web MVC + embedded Tomcat. Provides the servlet container (so our
          OncePerRequestFilter runs), @RestController endpoints, and the
          RestClient builder we use to make the second (outbound) hop.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          Test starter: JUnit 5 (Jupiter), AssertJ, Mockito, Spring Test, all
          version-managed by the parent. test scope only. We use it to boot the
          app on a random port and assert the traceId propagates across the hop.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              The Spring Boot Maven plugin lets you `mvn spring-boot:run` and
              repackages an executable fat-jar with `mvn package`.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
