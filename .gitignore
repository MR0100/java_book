# Auto-generated, regenerable output — never tracked (see GUIDE.md to rebuild).
# IMPORTANT: .gitignore has NO inline comments — text after a pattern on the
# same line becomes part of the pattern and makes it match nothing. Keep every
# comment on its own line, like these.
#   /dochub/ = static web book   (python scripts/web/build_dochub.py)
#   /audio/  = MP3 narration      (scripts/audio/build.sh  or  build.ps1)
/dochub/
/audio/

# Build output (examples/ also has its own .gitignore)
**/target/
**/build/
dependency-reduced-pom.xml

# Profiling / diagnostics artifacts
*.hprof
*.jfr
hs_err_pid*.log

# OS / editor junk
.DS_Store
*.iml
.idea/
.vscode/
